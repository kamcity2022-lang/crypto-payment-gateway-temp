<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>gateway-api-secrets-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Gateway.Application\Gateway.Application.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Gateway.Persistence\Gateway.Persistence.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Gateway.Infrastructure\Gateway.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Gateway.Blockchain.Tron\Gateway.Blockchain.Tron.csproj" />
  </ItemGroup>

</Project>
